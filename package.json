{
  "name": "capnweb-tunnel",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "bin": {
    "capnweb-tunnel": "dist/cli.js"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "exports": {
    ".": {
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.lib.json",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "vitest run test/*.test.ts",
    "test:unit": "vitest run test/worker.test.ts",
    "cli": "node src/cli.ts"
  },
  "dependencies": {
    "capnweb": "^0.8.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260515.1",
    "@types/node": "^25.8.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "wrangler": "^4.92.0"
  }
}
