{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "captun",
  "main": "src/worker/worker.ts",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "durable_objects": {
    "bindings": [{ "name": "CaptunServerShard", "class_name": "CaptunServerShard" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CaptunServerShard"] }],
}
