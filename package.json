{
  "name": "captun",
  "version": "0.0.1",
  "private": false,
  "description": "A tiny Cap'n Web tunnel for forwarding public Worker requests to a local fetcher.",
  "repository": {
    "type": "git",
    "url": "https://github.com/iterate/captun.git"
  },
  "bin": {
    "captun": "./src/cli/bin.ts"
  },
  "files": [
    "dist",
    "README.md",
    "wrangler.jsonc"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "bin": {
      "captun": "./dist/cli/bin.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.lib.json",
    "check": "pnpm run typecheck && pnpm run lint:check && pnpm run format:check",
    "typecheck": "tsc -p tsconfig.json && pnpm --recursive --filter '!captun' --if-present run typecheck",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint . --threads 1 --deny-warnings",
    "lint:check": "pnpm run lint",
    "lint:fix": "oxlint . --fix",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:unit": "vitest run test/worker.test.ts",
    "cli": "tsx src/cli/bin.ts",
    "smoke": "./scripts/smoke-test.sh",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run check && pnpm run test",
    "publish:dry-run": "pnpm publish --dry-run --no-git-checks"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.3",
    "@orpc/server": "^1.14.3",
    "capnweb": "^0.8.0",
    "trpc-cli": "^0.14.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260515.1",
    "@types/node": "^25.8.0",
    "esbuild": "^0.28.0",
    "miniflare": "^4.20260515.0",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "tsx": "^4.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "wrangler": "^4.92.0"
  },
  "packageManager": "pnpm@10.11.1"
}
