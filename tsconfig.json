{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "worker-configuration.d.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "examples/*/*.ts"
  ]
}
