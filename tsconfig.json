{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "worker-configuration.d.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "examples/*/*.ts"
  ],
  "exclude": ["examples/bun/server.ts", "examples/deno/server.ts"]
}
