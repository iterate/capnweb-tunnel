{
  "name": "captun",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/iterate/captun.git"
  },
  "bin": {
    "captun": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "wrangler.toml"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.lib.json",
    "typecheck": "tsc --noEmit && pnpm --filter @captun/weather-reporter typecheck",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "pnpm run test:root && pnpm --filter @captun/weather-reporter test",
    "test:root": "vitest run test/*.test.ts",
    "test:unit": "vitest run test/worker.test.ts",
    "cli": "node src/cli.ts"
  },
  "dependencies": {
    "capnweb": "^0.8.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260515.1",
    "@types/node": "^25.8.0",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "wrangler": "^4.92.0"
  }
}
