{
  "compilerOptions": {
    "outDir": "dist",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "declaration": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "captun": ["./src/index.ts"],
      "captun/client": ["./src/client.ts"],
      "captun/server": ["./src/server.ts"]
    }
  },
  "include": [
    "worker-configuration.d.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "examples/weather-reporter/src/**/*.ts",
    "examples/weather-reporter/test/**/*.ts",
    "vite.config.ts"
  ]
}
